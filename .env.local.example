# ⚠️ ARCHIVO DE CONFIGURACIÓN LOCAL
# Copia este archivo como `.env.local` para desarrollo

# 📧 Email de testing para desarrollo local
# IMPORTANTE: Usa un email REAL y VÁLIDO (ej: tu Gmail personal)
# Todos los emails enviados desde localhost se redirigirán aquí
VITE_TEST_EMAIL=

# 📨 Configura tus credenciales de EmailJS aquí
# (cópialas desde .env.example)

# ============================================
# OFFLINE (outbox de ventas y snapshots locales)
# ============================================
VITE_ENABLE_OFFLINE_SNAPSHOT=false
